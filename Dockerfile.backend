FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps for pyarrow / numpy wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
COPY gcp/requirements-gcp.txt ./requirements-gcp.txt
RUN pip install -r requirements.txt -r requirements-gcp.txt

# Copy only what the backend needs — keep the image small.
COPY environment/ ./environment/
COPY agents/      ./agents/
COPY training/    ./training/
COPY backend/     ./backend/
COPY experiments/ ./experiments/

# Cloud Run / docker-compose can override these via env, but provide defaults.
ENV BACKEND_HOST=0.0.0.0 \
    BACKEND_PORT=8000

EXPOSE 8000

# Cloud Run injects $PORT; fall back to BACKEND_PORT for local docker.
CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-${BACKEND_PORT:-8000}}"]
