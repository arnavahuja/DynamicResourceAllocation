# ── Cluster Environment ──────────────────────────────────────────
N_SERVERS=15
MAX_QUEUE_SIZE=5
SLA_LATENCY_DEADLINE=30
ALPHA=5.0
BETA=60.0

P_IDLE=100.0
P_MAX=300.0
POWER_ALPHA=1.4

# Sleep model — server can be put to sleep, drawing only SLEEP_STANDBY_FACTOR · p_idle.
# Wake takes SERVER_WAKEUP_DELAY steps (during which the server draws full p_idle
# but cannot accept jobs).
SLEEP_STANDBY_FACTOR=0.05
SERVER_WAKEUP_DELAY=1
# Per-action cost charged when the agent toggles a server's sleep/wake state.
# Discourages flicker; useful sleeps (server stays asleep many steps) clear it easily.
TOGGLE_PENALTY=0.2

# Workload — lower arrival rate creates headroom for sleep decisions to save power.
SYNTHETIC_ARRIVAL_RATE=0.5

EPISODE_LENGTH=1000
INVALID_ACTION_PENALTY=-10.0

# ── Training ─────────────────────────────────────────────────────
GAMMA=0.99
LEARNING_RATE=3e-4
BATCH_SIZE=64
REPLAY_BUFFER_SIZE=100000
TARGET_UPDATE_FREQ=1000
EPSILON_START=1.0
EPSILON_END=0.05
EPSILON_DECAY=0.999
PPO_CLIP=0.2
PPO_EPOCHS=10
MAX_EPISODES=5000

# ── WandB ─────────────────────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=cloud-rl-scheduler
WANDB_ENTITY=

# ── Backend ───────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./experiments.db

# ── GCP ───────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
