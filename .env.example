# ── Cluster Environment ──────────────────────────────────────────
N_SERVERS=10
MAX_QUEUE_SIZE=5
SLA_LATENCY_DEADLINE=10
ALPHA=1.0
BETA=50.0

P_IDLE=100.0
P_MAX=300.0
POWER_ALPHA=1.4

EPISODE_LENGTH=1000
INVALID_ACTION_PENALTY=-10.0

# ── Training ─────────────────────────────────────────────────────
GAMMA=0.99
LEARNING_RATE=3e-4
BATCH_SIZE=64
REPLAY_BUFFER_SIZE=100000
TARGET_UPDATE_FREQ=1000
EPSILON_START=1.0
EPSILON_END=0.05
EPSILON_DECAY=0.999
PPO_CLIP=0.2
PPO_EPOCHS=10
MAX_EPISODES=5000

# ── WandB ─────────────────────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=cloud-rl-scheduler
WANDB_ENTITY=

# ── Backend ───────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./experiments.db

# ── GCP ───────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
